# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# Comma-separated origins allowed to call the API / open the WebSocket.
CORS_ORIGINS=http://localhost:5173
# Simulation tick interval in milliseconds (spec recommends 250-1000).
SIMULATION_TICK_MS=500
# Seed for deterministic, repeatable demo runs.
SIMULATION_SEED=42
# Average walking pace, used to decide whether you can reach a stop in time.
WALKING_SPEED_KMH=4.8
# Signing key for session tokens. The default in code is obviously not a
# secret and is fine locally; set a real one anywhere it matters.
AUTH_SECRET=dev-only-not-a-secret
# How long a sign-in lasts, in hours.
SESSION_HOURS=12
# Trip history. SQLite; the file is gitignored and regenerated on demand.
DATABASE_URL=sqlite:///./data/ridesync.db
HISTORY_ENABLED=true

# --- Frontend (Vite: only VITE_* vars reach the browser) ---------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/shuttles
# MapLibre style. OpenFreeMap Liberty needs no API key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
